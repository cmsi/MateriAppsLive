#!/bin/bash -eux

VB_VERSION=$(VBoxManage -V | cut -d. -f1)
CE6_VERSION="@CE6_VERSION@"
ARCH=$(arch)
if [ "$ARCH" = "x86_64" ]; then
  	arch="amd64"
else
  	arch="arm64"
fi

if [ -f ce6-${arch}.json ]; then
	rm -rf output-virtualbox-iso
	packer build ce6-${arch}.json 2>&1 | tee build-ce6-${arch}.log
	if [ -f output-virtualbox-iso/ceenv-${CE6_VERSION}-${arch}.ova ]; then
		mv -f output-virtualbox-iso/ceenv-${CE6_VERSION}-${arch}.ova .
	else
	    echo "Error: build failed."
	    exit 127
	fi
fi
